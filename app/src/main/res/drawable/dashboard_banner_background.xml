<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#2878B2"
                android:endColor="#348BC4" />
        </shape>
    </item>

    <item
        android:width="260dp"
        android:height="260dp"
        android:gravity="right|top"
        android:right="-135dp"
        android:top="-65dp">
        <shape android:shape="oval">
            <solid android:color="#12FFFFFF" />
        </shape>
    </item>

    <item
        android:width="230dp"
        android:height="230dp"
        android:gravity="right|bottom"
        android:right="-85dp"
        android:bottom="-145dp">
        <shape android:shape="oval">
            <solid android:color="#16FFFFFF" />
        </shape>
    </item>

</layer-list>
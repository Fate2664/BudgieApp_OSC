<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:clickable="true"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="#EEEEEE"
    android:backgroundTint="@color/white"
    app:strokeWidth="1dp"
    tools:context=".widgets.AchievementProgressWidget">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="5dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your progress"
                android:textStyle="bold"
                android:textSize="25sp"/>

            <TextView
                android:id="@+id/txtAchievementsEarned"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3 achievements earned"
                android:textSize="18sp"
                android:textColor="@color/soft_black"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="5dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardBackgroundColor="#2B03CAB8"
                android:layout_gravity="center"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="38dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_gravity="center"
                    android:contentDescription="star"
                    app:tint="@color/darkTeal"
                    android:src="@drawable/baseline_medal_24"/>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardBackgroundColor="#38F0D600"
                android:layout_gravity="center"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="38dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_gravity="center"
                    android:contentDescription="stars"
                    app:tint="#A68800"
                    android:src="@drawable/baseline_auto_awesome_24"/>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardBackgroundColor="#3C9A71E4"
                android:layout_gravity="center"
                android:layout_marginEnd="10dp"
                app:cardCornerRadius="38dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_gravity="center"
                    android:contentDescription="streak"
                    app:tint="#812292"
                    android:src="@drawable/ic_achievement_trophy"/>

            </com.google.android.material.card.MaterialCardView>

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="arrow"
                app:tint="#8E8E8E"
                android:src="@drawable/baseline_arrow_forward_ios_24"/>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <!-- Date -->
        <TextView
            android:id="@+id/txtTransactionDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:gravity="start"
            android:maxLines="1"
            android:text="29/07/26"
            android:textColor="@color/black"
            android:textSize="12sp" />

        <!-- Category -->
        <TextView
            android:id="@+id/txtTransactionCategory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.4"
            android:ellipsize="end"
            android:gravity="start"
            android:maxLines="1"
            android:text="Food"
            android:textColor="@color/black"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Payee -->
        <TextView
            android:id="@+id/txtTransactionPayee"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.8"
            android:ellipsize="end"
            android:gravity="start"
            android:maxLines="1"
            android:text="Woolworths"
            android:textColor="@color/black"
            android:textSize="13sp" />

        <!-- Attachment -->
        <ImageButton
            android:id="@+id/btnAttachment"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Open attachment"
            android:padding="10dp"
            android:visibility="visible"
            tools:src="@android:drawable/ic_menu_gallery" />

        <!-- Amount -->
        <TextView
            android:id="@+id/txtTransactionAmount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:gravity="end"
            android:maxLines="1"
            android:text="R200.00"
            android:textColor="@color/light_red"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/black_transparent"/>

</LinearLayout>
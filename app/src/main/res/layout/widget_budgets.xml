<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="#EEEEEE"
    app:strokeWidth="1dp"
    tools:context=".widgets.BudgetsWidget">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/txtBudgetHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Budgets"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtTip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Am I keeping up with my budgets?"
            android:textSize="15sp" />

        <View
            android:id="@+id/breaker"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="5dp"
            android:background="@color/input_blue" />

        <TextView
            android:id="@+id/txtTimePeriod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="THIS MONTH"
            android:textColor="@color/soft_black"
            android:textSize="14sp" />


        <!-- Monthly Budget Summary -->
        <TextView
            android:id="@+id/txtBudgetRemaining"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/soft_black"
            android:textSize="24sp"
            android:textStyle="bold"
            android:text="R3 200 remaining"/>

        <TextView
            android:id="@+id/txtBudgetSpent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/soft_black"
            android:textSize="15sp"
            android:text="R4 800 spent of R8 000" />

        <ProgressBar
            android:id="@+id/progressMonthlyBudget"
            style="?android:progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginTop="12dp"
            android:indeterminate="false"
            android:max="100"
            android:progressDrawable="@drawable/custom_progressbar"
            android:progressTint="#3F51B5"
            android:progress="60"/>

        <TextView
            android:id="@+id/txtBudgetPercentage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="end"
            android:textColor="@color/soft_black"
            android:textSize="13sp"
            android:text="60% used" />

        <View
            android:id="@+id/breaker2"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="10dp"
            android:background="@color/input_blue"/>

        <!-- Individual Budgets -->
        <LinearLayout
            android:id="@+id/budgetListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">


        </LinearLayout>


    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddNewBudget"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="end"
        android:layout_margin="5dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:contentDescription="Create new budget"
        app:backgroundTint="@color/background_header"
        app:cornerRadius="24dp"
        app:icon="@drawable/baseline_add_24"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="24dp"
        app:iconTint="@color/white" />

</com.google.android.material.card.MaterialCardView>